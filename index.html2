<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Victory Obongha — Social Media Strategist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#001241;
    --ink-soft:#0c2559;
    --mist:#ceced1;
    --mist-soft:#e4e4e6;
    --paper:#f7f6f4;
    --white:#ffffff;
    --gold:#c9a227;
    --gold-soft:#e3c65f;
    --text-dim: rgba(255,255,255,0.72);
    --shadow: 0 30px 60px -30px rgba(0,18,65,0.35);
    --ease: cubic-bezier(.16,.84,.44,1);
  }

  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--paper);
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    font-weight:500;
  }
  h1,h2,h3,h4{
    font-family:'Fraunces',serif;
    font-weight:500;
    line-height:1.08;
    letter-spacing:-0.01em;
  }
  .section-label{
    color:var(--gold);
  }
  .container{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
  }
  section{position:relative;}

  /* ===== Reveal on scroll ===== */
  .reveal{
    opacity:0;
    transform:translateY(28px);
    transition:opacity 0.9s var(--ease), transform 0.9s var(--ease);
  }
  .reveal.is-visible{opacity:1;transform:translateY(0);}
  .reveal-stagger.is-visible > *{opacity:1;transform:translateY(0);}
  .reveal-stagger > *{
    opacity:0;
    transform:translateY(22px);
    transition:opacity 0.7s var(--ease), transform 0.7s var(--ease);
  }
  .reveal-stagger.is-visible > *:nth-child(1){transition-delay:0.05s;}
  .reveal-stagger.is-visible > *:nth-child(2){transition-delay:0.15s;}
  .reveal-stagger.is-visible > *:nth-child(3){transition-delay:0.25s;}
  .reveal-stagger.is-visible > *:nth-child(4){transition-delay:0.35s;}
  .reveal-stagger.is-visible > *:nth-child(5){transition-delay:0.45s;}
  .reveal-stagger.is-visible > *:nth-child(6){transition-delay:0.55s;}

  @media (prefers-reduced-motion: reduce){
    .reveal, .reveal-stagger > *{opacity:1 !important;transform:none !important;transition:none !important;}
    *{animation:none !important;}
  }

  /* ===== Nav ===== */
  .nav{
    position:fixed;
    top:0;left:0;right:0;
    z-index:1000;
    background:rgba(247,246,244,0.86);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid rgba(0,18,65,0.08);
    transition:background 0.3s ease;
  }
  .nav-inner{
    max-width:1180px;
    margin:0 auto;
    padding:18px 32px;
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .nav-logo{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:1.15rem;
    letter-spacing:-0.01em;
  }
  .nav-links{
    display:flex;
    align-items:center;
    gap:34px;
    list-style:none;
  }
  .nav-links a{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.75rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--ink);
    opacity:0.75;
    position:relative;
    padding-bottom:4px;
    transition:opacity 0.25s ease;
  }
  .nav-links a::after{
    content:'';
    position:absolute;
    bottom:0;left:0;
    width:0%;height:1px;
    background:var(--gold);
    transition:width 0.3s var(--ease);
  }
  .nav-links a:hover{opacity:1;}
  .nav-links a:hover::after{width:100%;}
  .btn-nav{
    background:var(--ink);
    color:var(--white) !important;
    padding:10px 22px;
    border-radius:100px;
    font-size:0.72rem !important;
    opacity:1 !important;
  }
  .btn-nav::after{display:none;}
  .nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:6px;}
  .nav-toggle span{display:block;width:22px;height:2px;background:var(--ink);margin:5px 0;transition:0.3s;}

  /* ===== Buttons ===== */
  .btn{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:15px 30px;
    border-radius:100px;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.78rem;
    letter-spacing:0.04em;
    font-weight:500;
    cursor:pointer;
    border:1px solid transparent;
    transition:transform 0.2s var(--ease), box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;
    will-change:transform;
  }
  .btn-primary{
    background:var(--gold);
    color:var(--ink);
  }
  .btn-primary:hover{box-shadow:0 16px 32px -12px rgba(201,162,39,0.55);}
  .btn-outline{
    background:transparent;
    color:var(--ink);
    border-color:rgba(0,18,65,0.25);
  }
  .btn-outline:hover{border-color:var(--ink);background:rgba(0,18,65,0.04);}
  .btn-outline-light{
    background:transparent;
    color:var(--white);
    border-color:rgba(255,255,255,0.35);
  }
  .btn-outline-light:hover{border-color:var(--white);background:rgba(255,255,255,0.08);}

  /* ===== Hero ===== */
  .hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:140px 0 80px;
    position:relative;
    overflow:hidden;
  }
  .orb{
    position:absolute;
    border-radius:50%;
    filter:blur(70px);
    opacity:0.35;
    pointer-events:none;
  }
  .orb-1{width:420px;height:420px;background:radial-gradient(circle,var(--gold-soft),transparent 70%);top:-100px;right:-60px;animation:float1 16s ease-in-out infinite;}
  .orb-2{width:340px;height:340px;background:radial-gradient(circle,var(--ink-soft),transparent 70%);opacity:0.12;bottom:-80px;left:10%;animation:float2 20s ease-in-out infinite;}
  .orb-3{width:260px;height:260px;background:radial-gradient(circle,var(--gold-soft),transparent 70%);opacity:0.18;top:40%;left:60%;animation:float3 14s ease-in-out infinite;}
  @keyframes float1{0%,100%{transform:translate(0,0);}50%{transform:translate(-40px,50px);}}
  @keyframes float2{0%,100%{transform:translate(0,0);}50%{transform:translate(50px,-30px);}}
  @keyframes float3{0%,100%{transform:translate(0,0);}50%{transform:translate(-30px,-40px);}}

  .hero-grid{
    display:grid;
    grid-template-columns:1.15fr 0.85fr;
    gap:60px;
    align-items:center;
    position:relative;
    z-index:2;
  }
  .hero-eyebrow{
    display:inline-flex;
    align-items:center;
    gap:10px;
    color:var(--ink);
    opacity:0.6;
    margin-bottom:22px;
  }
  .hero-eyebrow::before{
    content:'';
    width:28px;height:1px;
    background:var(--gold);
  }
  .hero h1{
    font-size:clamp(2.4rem, 4.6vw, 3.9rem);
    color:var(--ink);
    margin-bottom:26px;
  }
  .hero h1 .accent{
    color:var(--gold);
    font-style:italic;
  }
  .hero p.sub{
    font-size:1.08rem;
    line-height:1.65;
    color:rgba(0,18,65,0.68);
    max-width:520px;
    margin-bottom:38px;
  }
  .hero-btns{display:flex;gap:16px;flex-wrap:wrap;}

  .hero-photo-wrap{
    position:relative;
    display:flex;
    justify-content:center;
    align-items:center;
  }
  .photo-ring{
    position:relative;
    width:300px;height:375px;
    border-radius:28px;
    display:flex;align-items:center;justify-content:center;
  }
  .photo-ring::before,.photo-ring::after{
    content:'';
    position:absolute;
    inset:-14px;
    border-radius:36px;
    border:1px solid var(--gold);
    opacity:0.5;
    animation:pulse-ring 3s var(--ease) infinite;
  }
  .photo-ring::after{
    inset:-28px;
    border-radius:44px;
    animation-delay:0.6s;
    opacity:0.28;
  }
  @keyframes pulse-ring{
    0%{transform:scale(0.96);opacity:0.55;}
    70%{transform:scale(1.03);opacity:0;}
    100%{transform:scale(1.03);opacity:0;}
  }
  .photo-circle{
    width:300px;height:375px;
    border-radius:24px;
    overflow:hidden;
    border:6px solid var(--paper);
    box-shadow:var(--shadow);
    position:relative;
    z-index:2;
  }
  .photo-circle img{width:100%;height:100%;object-fit:cover;object-position:center top;}

  /* ===== About ===== */
  .about{
    background:var(--ink);
    color:var(--white);
    padding:120px 0;
  }
  .about-grid{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:70px;
    align-items:start;
  }
  .about-photo-card{
    position:relative;
    border-radius:22px;
    overflow:hidden;
    box-shadow:0 40px 80px -30px rgba(0,0,0,0.5);
  }
  .about-photo-card img{width:100%;height:auto;display:block;}
  .about-badge{
    position:absolute;
    bottom:18px;left:18px;right:18px;
    background:var(--gold);
    color:var(--ink);
    padding:14px 18px;
    border-radius:14px;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.78rem;
    font-weight:600;
    letter-spacing:0.02em;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .about-label{color:var(--gold);margin-bottom:16px;}
  .about h2{
    font-size:clamp(1.9rem,3vw,2.6rem);
    margin-bottom:26px;
    color:var(--white);
  }
  .about p{
    color:var(--text-dim);
    line-height:1.75;
    margin-bottom:18px;
    font-size:1rem;
    max-width:560px;
  }
  .about p strong{color:var(--white);font-weight:600;}

  .stat-row{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
    margin-top:46px;
  }
  .stat-box{
    border:1px solid rgba(255,255,255,0.14);
    border-radius:16px;
    padding:26px 20px;
    background:rgba(255,255,255,0.03);
  }
  .stat-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:2.1rem;
    font-weight:600;
    color:var(--gold);
    display:block;
    margin-bottom:8px;
  }
  .stat-label{
    font-size:0.85rem;
    color:var(--text-dim);
    line-height:1.4;
  }

  /* ===== Services ===== */
  .services{padding:120px 0;}
  .section-head{
    max-width:640px;
    margin-bottom:64px;
  }
  .section-head .eyebrow{margin-bottom:14px;display:block;}
  .section-head h2{font-size:clamp(1.9rem,3.2vw,2.6rem);margin-bottom:16px;}
  .section-head p{color:rgba(0,18,65,0.62);font-size:1.05rem;line-height:1.6;}

  .services-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:2px;
    background:rgba(0,18,65,0.1);
    border:1px solid rgba(0,18,65,0.1);
    border-radius:20px;
    overflow:hidden;
  }
  .service-card{
    background:var(--paper);
    padding:38px 30px;
    position:relative;
    transition:background 0.35s ease;
  }
  .service-card::before{
    content:'';
    position:absolute;
    left:0;top:0;bottom:0;
    width:3px;
    background:var(--gold);
    transform:scaleY(0);
    transform-origin:top;
    transition:transform 0.4s var(--ease);
  }
  .service-card:hover::before{transform:scaleY(1);}
  .service-card:hover{background:var(--white);}
  .service-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.75rem;
    color:var(--gold);
    margin-bottom:18px;
    display:block;
  }
  .service-card h3{
    font-size:1.18rem;
    margin-bottom:12px;
    color:var(--ink);
    font-weight:600;
  }
  .service-card p{
    font-size:0.92rem;
    line-height:1.6;
    color:rgba(0,18,65,0.62);
  }

  /* ===== Work ===== */
  .work{
    background:var(--mist-soft);
    padding:120px 0;
  }
  .work-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:28px;
  }
  .work-card{
    background:var(--white);
    border-radius:20px;
    padding:34px 28px;
    box-shadow:0 18px 40px -24px rgba(0,18,65,0.18);
    display:flex;
    flex-direction:column;
    height:100%;
  }
  .work-avatar{
    width:56px;height:56px;
    border-radius:50%;
    background:var(--ink);
    color:var(--gold);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;
    font-size:1.3rem;
    font-weight:600;
    margin-bottom:20px;
    border:2px solid var(--gold);
  }
  .work-card h3{font-size:1.15rem;margin-bottom:4px;}
  .work-niche{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:18px;
  }
  .work-desc{
    font-size:0.92rem;
    line-height:1.6;
    color:rgba(0,18,65,0.65);
    margin-bottom:24px;
    flex-grow:1;
  }
  .work-result{
    border-top:1px solid rgba(0,18,65,0.08);
    padding-top:18px;
    display:flex;
    align-items:baseline;
    gap:10px;
  }
  .work-result .count{
    font-family:'IBM Plex Mono',monospace;
    font-size:1.7rem;
    font-weight:600;
    color:var(--ink);
  }
  .work-result .count-label{
    font-size:0.78rem;
    color:rgba(0,18,65,0.55);
    line-height:1.3;
  }

  /* ===== Certification ===== */
  .cert{
    background:var(--ink);
    padding:120px 0;
    color:var(--white);
    position:relative;
    overflow:hidden;
  }
  .cert::before{
    content:'';
    position:absolute;
    width:500px;height:500px;
    border-radius:50%;
    background:radial-gradient(circle,rgba(201,162,39,0.16),transparent 70%);
    top:-200px;right:-150px;
  }
  .cert-grid{
    display:grid;
    grid-template-columns:0.9fr 1.1fr;
    gap:60px;
    align-items:center;
    position:relative;
    z-index:2;
  }
  .cert-label{color:var(--gold);margin-bottom:16px;display:block;}
  .cert h2{font-size:clamp(1.9rem,3vw,2.5rem);margin-bottom:20px;}
  .cert p{color:var(--text-dim);line-height:1.7;margin-bottom:14px;max-width:480px;}
  .cert-meta{
    margin-top:28px;
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .cert-meta-row{
    display:flex;
    gap:12px;
    font-size:0.9rem;
    color:var(--text-dim);
  }
  .cert-meta-row .k{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--gold);
    min-width:110px;
  }
  .cert-image-card{
    border-radius:18px;
    overflow:hidden;
    transform:rotate(-2deg);
    box-shadow:0 50px 90px -30px rgba(0,0,0,0.6);
    transition:transform 0.5s var(--ease);
    border:6px solid rgba(255,255,255,0.06);
  }
  .cert-image-card:hover{transform:rotate(0deg) scale(1.02);}
  .cert-image-card img{width:100%;display:block;}

  .cert-head{max-width:640px;margin-bottom:56px;}
  .cert-head h2{font-size:clamp(1.9rem,3vw,2.5rem);margin-bottom:16px;color:var(--white);}
  .cert-head p{color:var(--text-dim);line-height:1.7;font-size:1.02rem;}
  .cert-cards{
    display:flex;
    flex-direction:column;
    gap:28px;
    max-width:640px;
    margin:0 auto;
  }
  .cert-card{
    background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.12);
    border-radius:20px;
    overflow:hidden;
    transition:transform 0.4s var(--ease), border-color 0.3s ease;
  }
  .cert-card:hover{transform:translateY(-8px);border-color:var(--gold);}
  .cert-card-img{
    overflow:hidden;
    border-bottom:1px solid rgba(255,255,255,0.1);
    background:var(--white);
    padding:18px;
  }
  .cert-card-img img{
    width:100%;
    height:auto;
    display:block;
    border-radius:4px;
  }
  .cert-card-body{padding:22px 22px 26px;}
  .cert-card-body h3{
    font-size:1.02rem;
    color:var(--white);
    margin-bottom:10px;
    font-family:'Fraunces',serif;
    font-weight:500;
  }
  .cert-card-meta{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    color:var(--gold);
    letter-spacing:0.02em;
    margin-bottom:6px;
  }
  .cert-card-date{
    font-size:0.8rem;
    color:var(--text-dim);
  }

  /* ===== Contact ===== */
  .contact{
    padding:130px 0 90px;
    text-align:center;
  }
  .contact h2{
    font-size:clamp(2.1rem,4vw,3.1rem);
    margin-bottom:20px;
  }
  .contact p{
    max-width:520px;
    margin:0 auto 40px;
    color:rgba(0,18,65,0.62);
    font-size:1.05rem;
    line-height:1.65;
  }
  .contact-socials{
    margin-top:36px;
    display:flex;
    justify-content:center;
    gap:28px;
  }
  .contact-socials a{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.8rem;
    letter-spacing:0.04em;
    color:rgba(0,18,65,0.6);
    border-bottom:1px solid transparent;
    padding-bottom:2px;
    transition:0.25s ease;
  }
  .contact-socials a:hover{color:var(--ink);border-color:var(--gold);}
  .closing-line{
    margin-top:56px;
    font-family:'Fraunces',serif;
    font-style:italic;
    font-size:1.2rem;
    color:var(--ink);
    opacity:0.75;
  }

  /* ===== Footer ===== */
  footer{
    background:#000b26;
    color:rgba(255,255,255,0.6);
    padding:50px 0 30px;
  }
  .footer-inner{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    flex-wrap:wrap;
    gap:24px;
    padding-bottom:30px;
    border-bottom:1px solid rgba(255,255,255,0.08);
    margin-bottom:24px;
  }
  .footer-name{
    font-family:'Fraunces',serif;
    font-size:1.2rem;
    color:var(--white);
    margin-bottom:8px;
  }
  .footer-tag{font-size:0.88rem;max-width:280px;line-height:1.5;}
  .footer-links{
    display:flex;
    gap:26px;
    list-style:none;
    font-family:'IBM Plex Mono',monospace;
    font-size:0.75rem;
    letter-spacing:0.05em;
    text-transform:uppercase;
  }
  .footer-links a{opacity:0.7;transition:opacity 0.25s ease;}
  .footer-links a:hover{opacity:1;color:var(--gold);}
  .footer-bottom{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    opacity:0.5;
    text-align:center;
  }

  /* ===== Cursor glow (hero) ===== */
  .cursor-glow{
    position:absolute;
    width:480px;height:480px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(201,162,39,0.16), transparent 65%);
    pointer-events:none;
    transform:translate(-50%,-50%);
    opacity:0;
    transition:opacity 0.4s ease;
    z-index:1;
  }
  .hero:hover .cursor-glow{opacity:1;}

  /* ===== Scroll progress bar ===== */
  .scroll-progress{
    position:fixed;
    top:0;left:0;
    height:3px;
    width:0%;
    background:linear-gradient(90deg, var(--gold), var(--gold-soft));
    z-index:1100;
    transition:width 0.1s linear;
  }

  /* ===== Tools ===== */
  .tools{
    background:var(--paper);
    padding:100px 0;
    border-top:1px solid rgba(0,18,65,0.08);
    border-bottom:1px solid rgba(0,18,65,0.08);
  }
  .tools-grid{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:18px;
  }
  .tool-card{
    background:var(--white);
    border:1px solid rgba(0,18,65,0.1);
    border-radius:16px;
    padding:26px 16px;
    text-align:center;
    transition:transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s ease;
  }
  .tool-card:hover{
    transform:translateY(-6px);
    box-shadow:0 20px 40px -24px rgba(0,18,65,0.25);
    border-color:var(--gold);
  }
  .tool-icon{font-size:1.8rem;margin-bottom:10px;}
  .tool-name{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.72rem;
    letter-spacing:0.02em;
    color:var(--ink);
    font-weight:500;
  }
  .tools-note{
    margin-top:26px;
    font-size:0.85rem;
    color:rgba(0,18,65,0.5);
    font-style:italic;
  }

  /* ===== Pricing ===== */
  .pricing{
    background:var(--mist-soft);
    padding:120px 0;
  }
  .pricing-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:26px;
    align-items:stretch;
  }
  .price-card{
    background:var(--white);
    border-radius:22px;
    padding:40px 32px;
    display:flex;
    flex-direction:column;
    border:1px solid rgba(0,18,65,0.1);
    box-shadow:0 18px 40px -28px rgba(0,18,65,0.2);
    transition:transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
    position:relative;
  }
  .price-card:hover{transform:translateY(-8px);box-shadow:0 30px 60px -28px rgba(0,18,65,0.3);}
  .price-card.featured{
    background:var(--ink);
    color:var(--white);
    transform:scale(1.04);
    border-color:var(--ink);
  }
  .price-card.featured:hover{transform:scale(1.04) translateY(-8px);}
  .price-badge{
    position:absolute;
    top:-14px;left:50%;
    transform:translateX(-50%);
    background:var(--gold);
    color:var(--ink);
    font-family:'IBM Plex Mono',monospace;
    font-size:0.68rem;
    letter-spacing:0.06em;
    text-transform:uppercase;
    font-weight:600;
    padding:7px 16px;
    border-radius:100px;
    white-space:nowrap;
  }
  .price-name{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.75rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--gold);
    margin-bottom:14px;
  }
  .price-card:not(.featured) .price-name{color:var(--gold);}
  .price-amount{
    font-family:'Fraunces',serif;
    font-size:2.6rem;
    font-weight:600;
    margin-bottom:4px;
  }
  .price-amount span{
    font-family:'IBM Plex Mono',monospace;
    font-size:0.9rem;
    font-weight:400;
    opacity:0.6;
  }
  .price-tagline{
    font-size:0.9rem;
    margin-bottom:28px;
    opacity:0.7;
    line-height:1.5;
  }
  .price-features{
    list-style:none;
    display:flex;
    flex-direction:column;
    gap:14px;
    margin-bottom:32px;
    flex-grow:1;
  }
  .price-features li{
    font-size:0.9rem;
    line-height:1.5;
    display:flex;
    gap:10px;
    align-items:flex-start;
  }
  .price-features li::before{
    content:'✓';
    color:var(--gold);
    font-weight:700;
    flex-shrink:0;
  }
  .price-card .btn{width:100%;justify-content:center;}
  .price-card:not(.featured) .btn-primary{background:var(--ink);color:var(--white);}
  .pricing-note{
    text-align:center;
    margin-top:44px;
    color:rgba(0,18,65,0.55);
    font-size:0.92rem;
    max-width:560px;
    margin-left:auto;
    margin-right:auto;
  }

  /* ===== Free resource banner ===== */
  .resource-banner{
    background:linear-gradient(120deg, var(--ink) 0%, #052a52 100%);
    color:var(--white);
    border-radius:26px;
    padding:56px 48px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:40px;
    flex-wrap:wrap;
    position:relative;
    overflow:hidden;
  }
  .resource-banner::before{
    content:'';
    position:absolute;
    width:360px;height:360px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(201,162,39,0.22), transparent 70%);
    top:-140px;right:-80px;
  }
  .resource-banner-text{position:relative;z-index:2;max-width:560px;}
  .resource-eyebrow{color:var(--gold);margin-bottom:14px;display:block;}
  .resource-banner h2{font-size:clamp(1.6rem,2.6vw,2.1rem);color:var(--white);margin-bottom:14px;}
  .resource-banner p{color:var(--text-dim);line-height:1.65;font-size:0.98rem;}
  .resource-banner-cta{position:relative;z-index:2;flex-shrink:0;}

  /* ===== Tilt ===== */
  .tilt{transition:transform 0.25s ease-out;transform-style:preserve-3d;}

  /* ===== Responsive ===== */
  @media (max-width:900px){
    .hero-grid{grid-template-columns:1fr;text-align:left;}
    .hero-photo-wrap{order:-1;margin-bottom:20px;}
    .photo-circle{width:220px;height:275px;}
    .photo-ring{width:220px;height:275px;}
    .about-grid{grid-template-columns:1fr;}
    .stat-row{grid-template-columns:1fr 1fr;}
    .services-grid{grid-template-columns:1fr;}
    .work-grid{grid-template-columns:1fr;}
    .cert-grid{grid-template-columns:1fr;}
    .cert-image-card{order:-1;}
    .tools-grid{grid-template-columns:repeat(3,1fr);}
    .pricing-grid{grid-template-columns:1fr;}
    .price-card.featured{transform:none;}
    .price-card.featured:hover{transform:translateY(-8px);}
    .resource-banner{flex-direction:column;text-align:center;padding:44px 28px;}
    .resource-banner-text{max-width:100%;}
    .nav-links{
      position:fixed;
      top:0;right:0;
      height:100vh;
      width:min(78vw,320px);
      background:var(--paper);
      flex-direction:column;
      justify-content:center;
      align-items:flex-start;
      padding:40px;
      gap:26px;
      transform:translateX(100%);
      transition:transform 0.4s var(--ease);
      box-shadow:-10px 0 40px rgba(0,0,0,0.15);
    }
    .nav-links.open{transform:translateX(0);}
    .nav-toggle{display:block;}
    .footer-inner{flex-direction:column;}
  }
  @media (max-width:560px){
    .container{padding:0 20px;}
    .stat-row{grid-template-columns:1fr;}
    .hero{padding-top:120px;}
    .tools-grid{grid-template-columns:repeat(2,1fr);}
  }
</style>
</head>
